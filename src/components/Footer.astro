---
import siteData from '../content/data/site.json';

const { contact, name } = siteData;
const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="footer-row">
      
      <div class="footer-col">
        <h4>{name}</h4>
        <p>Hukuki Danışmanlık ve Çözüm Ortaklığı.</p>
        
        <div style="margin-top: 15px; font-size: 0.9rem; color: var(--color-text-secondary);">
          <p style="margin-bottom: 8px; display:flex; align-items:center; gap:10px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="color: var(--brand-accent);">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" fill="currentColor"></path>
              <path d="M12 11.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" fill="#fff" opacity="0.9"></path>
            </svg>
            <span>{contact.address || "Adres bilgisi yükleniyor..."}</span>
          </p>
          <p style="margin-bottom: 8px; display:flex; align-items:center; gap:10px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="color: var(--brand-accent);">
              <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1 .9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zM20 8l-8 5-8-5V6l8 5 8-5v2z" fill="currentColor"></path>
            </svg>
            <a href={`mailto:${contact.email}`} style="text-decoration: none; color: inherit;">{contact.email}</a>
          </p>
          <p style="display:flex; align-items:center; gap:10px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="color: var(--brand-accent);">
              <path d="M6.6 10.8c1.4 2.7 3.6 5 6.3 6.3l1.8-1.8c.2-.2.5-.3.8-.2 1 .3 2 .5 3 .5.4 0 .8.3.9.7.3 1.1.5 2.2.5 3.4 0 .5-.4.9-.9.9C13 21.5 2.5 11 2.5 4.9c0-.5.4-.9.9-.9 1.2 0 2.3.2 3.4.5.4.1.7.5.7.9 0 1 .2 2 .5 3 .1.3 0 .6-.2.8L6.6 10.8z" fill="currentColor"></path>
            </svg>
            <a href={contact.phoneLink} style="text-decoration: none; color: inherit;">{contact.phone}</a>
          </p>
        </div>
      </div>

      <div class="footer-col">
        <h4>Hızlı Erişim</h4>
        <ul>
          <li><a href="/hakkimda">Hakkımda</a></li>
          <li><a href="/calisma-alanlari">Çalışma Alanları</a></li>
          <li><a href="/yayinlar">Yayınlar</a></li>
          <li><a href="/iletisim">İletişim</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Yasal</h4>
        <ul>
          <li><a href="/legal/editoryal-politika">Editoryal Politika</a></li>
          <li><a href="/legal/kvkk-aydinlatma-metni">KVKK Aydınlatma Metni</a></li>
          <li><a href="/legal/yasal-uyari">Yasal Uyarı</a></li>
          <li><a href="/legal/gizlilik-bildirimi">Gizlilik Bildirimi</a></li>
          <li><a href="/legal/cerez-politikasi">Çerez Politikası</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-social">
        <a href="https://www.instagram.com/avukatfatihturan" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/fatih-turan-400b9724b/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
      <div class="footer-bottom">
      <p>&copy; {year} {name}. Her Hakkı Saklıdır.</p>
    </div>
  </div>
</footer>
<style>
  .footer-social {
    display: flex;
    gap: 16px;
    margin-top: 8px;
    padding: 16px 0 8px;
    border-top: 1px solid var(--color-border, #e2e8f0);
  }
  .footer-social a {
    color: var(--color-text-secondary);
    transition: color 0.2s;
  }
  .footer-social a:hover {
    color: var(--brand-accent);
  }
</style>
