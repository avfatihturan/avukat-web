---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 1. URL'leri Oluştur
export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(service => ({
    params: { slug: service.slug },
    props: { service, services },
  }));
}

const { service, services } = Astro.props;
const { Content } = await render(service);

// 2. Diğer Hizmetleri Filtrele
const otherServices = services
  .filter(s => s.slug !== service.slug)
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

// 3. İkon Eşleştirmesi
// TypeScript için bu objenin tipini string anahtarlı olarak tanımlıyoruz
const iconMap: Record<string, string> = {
  'gavel': `<path d="M14 13l-7.5 7.5c-.8.8-2 .8-2.8 0s-.8-2 0-2.8L11.2 10.2" /><path d="m16 11 2 2" /><path d="m11 16 2 2" /><path d="M17 8l-2-2" /><path d="m10.7 4.2 8.6 8.6c.8.8.8 2 0 2.8l-1.4 1.4c-.8.8-2 .8-2.8 0L6.5 8.4c-.8-.8-.8-2 0-2.8l1.4-1.4c.8-.8 2-.8 2.8 0Z" />`,
  'briefcase': `<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" /><rect width="20" height="14" x="2" y="6" rx="2" />`,
  'home': `<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" />`
};

// HATA DÜZELTİLDİ:
// Eğer ikon tanımlı değilse (undefined) veya listede yoksa 'gavel' kullan.
const iconKey = service.data.icon || 'gavel';
const currentIcon = iconMap[iconKey] || iconMap['gavel'];
---

<BaseLayout 
  title={`${service.data.title} | Av. Fatih Turan`}
  description={service.data.description}
>
  
  <header class="service-hero">
    <div class="hero-bg" style={`background-image: url('${service.data.heroImage}');`}></div>
    <div class="hero-overlay"></div>
    <div class="container hero-content">
      <div class="service-icon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={currentIcon} />
      </div>
      <h1>{service.data.title}</h1>
      <p class="lead">{service.data.description}</p>
    </div>
  </header>

  <div class="container main-wrapper">
    <div class="row">
      
      <main class="content-col">
        <article class="service-content">
          <Content />
        </article>

        <div class="service-cta">
          <h3>Hukuki Desteğe mi İhtiyacınız Var?</h3>
          <p>Ankara'daki hukuki süreçleriniz için profesyonel değerlendirme alın.</p>
          <a href="/iletisim" class="btn btn-primary">İletişime Geçin</a>
        </div>
      </main>

      <aside class="sidebar-col">
        <div class="sidebar-widget">
          <h3>Diğer Çalışma Alanları</h3>
          <ul class="service-list">
            {otherServices.map(s => (
              <li>
                <a href={`/calisma-alanlari/${s.slug}`}>
                  <span class="arrow">→</span>
                  {s.data.title.replace('Ankara ', '')}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="sidebar-widget contact-widget">
          <h3>Hızlı İletişim</h3>
          <p>Ofis: +90 532 610 08 05</p>
          <p>E-posta: av.fatihturan@outlook.com</p>
          <p class="location">📍 Ankara, Türkiye</p>
        </div>
      </aside>

    </div>
  </div>

</BaseLayout>

<style>
  /* HERO STİLLERİ */
  .service-hero {
    position: relative;
    padding: 120px 0 80px;
    color: #fff;
    text-align: center;
    background-color: var(--brand-dark);
    margin-bottom: 60px;
  }

  .hero-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background-size: cover;
    background-position: center;
    opacity: 0.3;
    z-index: 1;
  }
  
  .hero-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: linear-gradient(to bottom, rgba(10,25,47,0.8), var(--brand-dark));
    z-index: 2;
  }

  .hero-content {
    position: relative;
    z-index: 3;
    max-width: 800px;
    margin: 0 auto;
  }

  .service-icon {
    display: inline-flex;
    padding: 15px;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
    margin-bottom: 20px;
    color: var(--brand-accent);
    border: 1px solid rgba(255,255,255,0.2);
  }

  .hero-content h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .lead {
    font-size: 1.2rem;
    opacity: 0.9;
    font-weight: 300;
  }

  /* LAYOUT GRID */
  .main-wrapper .row {
    display: flex;
    gap: 50px;
    flex-wrap: wrap;
  }

  .content-col {
    flex: 2;
    min-width: 300px;
  }

  .sidebar-col {
    flex: 1;
    min-width: 250px;
  }

  /* İÇERİK STİLLERİ */
  .service-content {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .service-content :global(h2) {
    color: var(--brand-dark);
    font-size: 1.8rem;
    margin-top: 1.5rem;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--brand-accent);
    padding-bottom: 10px;
    display: inline-block;
  }

  .service-content :global(h3) {
    color: var(--brand-main);
    font-size: 1.4rem;
    margin-top: 2rem;
  }

  .service-content :global(ul) {
    padding-left: 20px;
    margin-bottom: 20px;
  }

  .service-content :global(li) {
    margin-bottom: 10px;
  }

  /* CTA KUTUSU */
  .service-cta {
    background: var(--color-bg-offset);
    padding: 30px;
    border-radius: 12px;
    text-align: center;
    margin-top: 50px;
    border: 1px solid var(--color-border);
  }

  .service-cta h3 {
    margin-top: 0;
    color: var(--brand-dark);
  }

  .btn-primary {
    display: inline-block;
    background: var(--brand-main);
    color: #fff;
    padding: 12px 30px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
    margin-top: 15px;
    transition: background 0.2s;
  }

  .btn-primary:hover {
    background: var(--brand-accent);
  }

  /* SIDEBAR STİLLERİ */
  .sidebar-widget {
    background: #fff;
    padding: 25px;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    margin-bottom: 30px;
    border: 1px solid var(--color-border);
  }

  .sidebar-widget h3 {
    font-size: 1.2rem;
    margin-top: 0;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-border);
    color: var(--brand-dark);
  }

  .service-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .service-list li {
    margin-bottom: 12px;
  }

  .service-list a {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--color-text-secondary);
    font-weight: 500;
    transition: all 0.2s;
  }

  .service-list a:hover {
    color: var(--brand-main);
    transform: translateX(5px);
  }

  .service-list .arrow {
    margin-right: 10px;
    color: var(--brand-accent);
    font-size: 0.9em;
  }

  .contact-widget p {
    margin-bottom: 10px;
    font-size: 0.95rem;
    color: var(--color-text-secondary);
  }

  /* MOBİL AYARLAR */
  @media (max-width: 768px) {
    .main-wrapper .row {
      flex-direction: column;
    }
    
    .hero-content h1 {
      font-size: 2rem;
    }
    
    .sidebar-col {
      order: 2;
    }
  }
</style>