---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Hero from '../../components/Hero.astro';
import siteData from '../../content/data/site.json';
import { isPublished } from '../../utils/posts';

const { contact } = siteData;

// 1. URL'leri Oluştur
export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map(service => ({
    params: { slug: service.id.replace(/\.md$/, '') },
    props: { service, services },
  }));
}

const { service, services } = Astro.props;
const { Content } = await render(service);

// 2. Diğer Hizmetleri Filtrele
const otherServices = services
  .filter(s => s.id !== service.id)
  .sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

// 3. İlgili Makaleleri Bul
const allArticles = await getCollection('articles');
const relatedArticles = allArticles
  .filter(article => {
    const articleTag = (article.data.tag || "").toLowerCase().trim();
    const serviceTag = (service.data.relatedTag || "").toLowerCase().trim();
    return isPublished(article) && serviceTag && articleTag === serviceTag;
  })
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// 4. İkon Eşleştirmesi (SENİN VERDİĞİN ÖZEL SVG KODLARI)
const iconMap: Record<string, string> = {
  // Gavel (Senin verdiğin kod)
  'gavel': `<path d="m14 13-8.381 8.38a1 1 0 0 1-3.001-3l8.384-8.381"/><path d="m16 16 6-6"/><path d="m21.5 10.5-8-8"/><path d="m8 8 6-6"/><path d="m8.5 7.5 8 8"/>`,
  
  // Gear / Settings (Senin verdiğin kod)
  'gear': `<path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"/><circle cx="12" cy="12" r="3"/>`,
  
  // Key Round (Senin verdiğin kod)
  'key': `<path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"/><circle cx="16.5" cy="7.5" r=".5" fill="currentColor"/>`
};

const iconKey = service.data.icon || 'gavel';
const currentIcon = iconMap[iconKey] || iconMap['gavel'];
---

<BaseLayout 
  title={`${service.data.title} | Av. Fatih Turan`}
  description={service.data.description}
>
  
  <Hero
    title={service.data.title}
    lead={service.data.description}
    size="sm"
    image={service.data.heroImage}
    altText={service.data.heroAlt}
  />

  <div class="container main-wrapper">
    <Breadcrumb items={[
      { label: "Ana Sayfa", href: "/" },
      { label: "Çalışma Alanları", href: "/calisma-alanlari" },
      { label: service.data.title }
    ]} />
    <div class="row">
      <main class="content-col">
        <article class="service-content">
          <Content />
        </article>

        <div class="service-cta">
          <h3>Hukuki Desteğe mi İhtiyacınız Var?</h3>
          <p>Ankara'daki hukuki süreçleriniz için profesyonel değerlendirme alın.</p>
          <a href="/iletisim" class="btn-cta">İletişime Geçin</a>
        </div>

        {relatedArticles.length > 0 && (
          <div class="related-articles-section">
            <h3>İlgili Yayınlar</h3>
            <div class="articles-grid">
              {relatedArticles.map((article) => (
                <ArticleCard 
                  title={article.data.title}
                  description={article.data.description}
                  href={`/yayinlar/${article.id.replace(/\.md$/, '')}`}
                  image={article.data.heroImage || '/images/banner-blog.webp'}
                  tag={article.data.tag || 'Hukuk'}
                />
              ))}
            </div>
          </div>
        )}
      </main>

      <aside class="sidebar-col">
        <div class="sidebar-widget">
          <h3>Diğer Çalışma Alanları</h3>
          <ul class="service-list">
            {otherServices.map(s => (
              <li>
                <a href={`/calisma-alanlari/${s.id.replace(/\.md$/, '')}`}>
                  <span class="arrow">→</span>
                  {s.data.title.replace('Ankara ', '')}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="sidebar-widget contact-widget">
          <h3>Hızlı İletişim</h3>
          <p>Ofis: {contact.phone}</p>
          <p>E-posta: <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
          <p class="location"><span aria-label="Konum" role="img">📍</span> Ankara, Türkiye</p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>

  .main-wrapper .row { display: flex; gap: 50px; flex-wrap: wrap; }
  .content-col { flex: 2; min-width: 300px; }
  .sidebar-col { flex: 1; min-width: 280px; }
  
  .service-content {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--color-text);
  }
  .service-content :global(h2) {
    color: var(--brand-dark);
    font-size: 1.8rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--brand-accent);
    padding-bottom: 10px;
    display: inline-block;
  }
  :global(html.dark) .service-content :global(h2) { color: #fff; }
  .service-content :global(h3) {
    color: var(--brand-main);
    font-size: 1.4rem;
    margin-top: 2rem;
  }
  .service-content :global(ul) { padding-left: 20px; margin-bottom: 20px; }
  .service-content :global(li) { margin-bottom: 10px; }

  /* CTA KUTUSU - ÖNEMLİ: RENKLER SABİT */
  .service-cta {
    background-color: #0a192f !important;
    padding: 40px;
    border-radius: 12px;
    text-align: center;
    margin-top: 60px;
    border: 1px solid rgba(255,255,255,0.1);
    color: #ffffff !important;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  }
  .service-cta h3 { margin-top: 0; color: #ffffff !important; font-size: 1.5rem; margin-bottom: 10px; }
  .service-cta p { color: rgba(255,255,255,0.85) !important; margin-bottom: 25px; }
  .btn-cta {
    display: inline-block;
    background: var(--brand-accent);
    color: #000;
    padding: 14px 35px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 700;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }
  .btn-cta:hover { 
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(212, 163, 115, 0.4);
    background: #fff;
  }

  /* SIDEBAR */
  .sidebar-widget {
    background: var(--card-bg);
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    margin-bottom: 30px;
    border: 1px solid var(--color-border);
  }
  :global(html.dark) .sidebar-widget {
    background: var(--card-bg);
    border-color: rgba(255,255,255,0.1);
  }
  .sidebar-widget h3 {
    font-size: 1.2rem;
    margin-top: 0;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 1px solid var(--color-border);
    color: var(--brand-dark);
  }
  :global(html.dark) .sidebar-widget h3 { color: #fff; }
  .service-list { list-style: none; padding: 0; margin: 0; }
  .service-list li { margin-bottom: 15px; }
  .service-list a {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--color-text-secondary);
    font-weight: 500;
    transition: all 0.2s;
    padding: 5px 0;
  }
  .service-list a:hover { color: var(--brand-main); transform: translateX(5px); }
  .service-list .arrow { margin-right: 12px; color: var(--brand-accent); font-size: 0.9em; }
  .contact-widget p { margin-bottom: 12px; font-size: 0.95rem; color: var(--color-text-secondary); }
  .related-articles-section {
    margin-top: 80px;
    padding-top: 40px;
    border-top: 1px solid var(--color-border);
  }
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 25px;
    margin-top: 25px;
  }
  @media (max-width: 768px) {
    .main-wrapper .row { flex-direction: column; }
    .hero-content h1 { font-size: 2rem; }
    .sidebar-col { order: 2; margin-top: 30px; }
    .service-cta { padding: 30px 20px; }
  }
</style>