---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { getEntry } from 'astro:content';
type AboutData = {
  photo?: string;
  photoAlt?: string;
  paragraphs: string[];
  signature?: {
    name?: string;
    bar?: string;
    barUrl?: string;
  };
};
const siteEntry = await getEntry('site', 'main');
if (!siteEntry) {
  throw new Error('Site verisi (site/main) bulunamadı.');
}
const aboutEntry = await getEntry('data', 'about');
if (!aboutEntry) {
  throw new Error('Hakkımda sayfası için gerekli veriler (data/about.json) bulunamadı.');
}
const { name } = siteEntry.data as any;
const aboutData = aboutEntry.data as AboutData;
const paragraphs: string[] = Array.isArray(aboutData?.paragraphs) ? aboutData.paragraphs : [];
const signature = aboutData?.signature ?? {};
const photo = aboutData?.photo;
const photoAlt = aboutData?.photoAlt ?? 'Av. Fatih Turan';
---
<BaseLayout
  title={`Hakkımda | ${name}`}
  description={`${name} hakkında bilgi. Disiplin, Strateji ve Hukuk vizyonu.`}
  currentPage="hakkimda"
  canonicalUrl="/hakkimda"
>
  <Hero title="Hakkımda" size="sm" />
  <section class="bg-light">
    <div class="container about-container">
      <div class="about-inner">
        {photo && (
          <div class="about-photo-wrap">
            <img
              src={photo}
              alt={photoAlt}
              class="about-photo"
              width="320"
              height="480"
              loading="eager"
              decoding="async"
            />
            {signature?.barUrl && (
              <div class="baro-badge">
                <a href={signature.barUrl} target="_blank" rel="noopener noreferrer">
                  Ankara Barosu Sicil No: {signature?.bar?.replace('Ankara Barosu - ', '')}
                </a>
              </div>
            )}
          </div>
        )}
        <div class="about-text">
          <h2 class="section-heading">Disiplin. Strateji. Hukuk.</h2>
          <div class="about-content">
            {paragraphs.map((paragraph: string) => (
              <p set:html={paragraph} />
            ))}
            <div class="about-signature">
              <p>
                <strong>{signature?.name}</strong><br />
                {signature?.barUrl ? (
                  <a href={signature.barUrl} target="_blank" rel="noopener noreferrer">
                    {signature?.bar}
                  </a>
                ) : (
                  signature?.bar
                )}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .about-container { max-width: 900px; margin: 0 auto; padding: 3rem 1rem; }
  .about-inner { display: flex; gap: 3rem; align-items: flex-start; }
  .about-photo-wrap { flex-shrink: 0; }
  .about-photo { width: 260px; height: auto; border-radius: 8px; object-fit: cover; display: block; }
  
  .about-text { flex: 1; }
  .about-content { font-size: 1.15rem; text-align: justify; line-height: 1.8; color: var(--color-text); }
  .about-content p { margin-bottom: 1.5em; }
  .about-signature { margin-top: 40px; padding-top: 20px; border-top: 2px solid var(--brand-accent); width: fit-content; }
  .about-photo-wrap .baro-badge { margin-top: 16px; margin-bottom: 0; text-align: center; }
  .baro-badge a { display: inline-flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--brand-primary); border: 1px solid var(--brand-accent); padding: 6px 14px; border-radius: 20px; font-weight: 600; text-decoration: none; }
  :global(html.dark) .baro-badge a { color: var(--color-text); }
  .section-heading { margin-bottom: 16px; font-weight: 700; color: var(--brand-primary); }
  :global(html.dark) .section-heading { color: var(--color-text); }
  @media (max-width: 768px) {
    .about-inner { flex-direction: column; align-items: center; }
    .about-photo { width: 200px; }
    .about-content { text-align: left; }
  }
</style>