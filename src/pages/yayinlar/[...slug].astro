---
import { getCollection, render } from 'astro:content';
// HATA ÇÖZÜMÜ: Burası alt klasörde olduğu için çift nokta (../../) kullanılır
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { isPublished } from '../../utils/posts';

export async function getStaticPaths() {
  // Sadece yayında olan (taslak değil ve pubDate'i gelmiş) makaleleri çeker
  const articles = await getCollection('articles', isPublished);
  return articles.map((article) => ({
    params: { slug: article.id.replace(/.md$/, "") },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
---

<ArticleLayout
  title={article.data.title ?? ''}
  description={article.data.description ?? ''}
  heroImage={article.data.heroImage ?? '/images/banner-blog.webp'}
  heroAlt={article.data.heroAlt ?? article.data.title ?? 'Blog Görseli'}
  tag={article.data.tag ?? 'Hukuk'}
  pubDate={article.data.pubDate}
  updatedDate={article.data.updatedDate}
  author={article.data.author ?? 'Av. Fatih Turan'}
  headings={headings}
  slug={article.id.replace(/.md$/, "")}
  faqs={article.data.faqs}
>
  <Content />
</ArticleLayout>