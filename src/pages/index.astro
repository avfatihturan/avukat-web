---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import AreaCard from '../components/AreaCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

import siteData from '../content/data/site.json';
import workAreasData from '../content/data/work-areas.json';

// MAKALELERİ ÇEK
const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const latestArticles = allArticles
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Verileri hazırla
const { name } = siteData;
const workAreas = Array.isArray(workAreasData) ? workAreasData : (workAreasData['data'] || []);
---

<BaseLayout
  title={`Ana Sayfa | ${name}`}
  description="Ankara'da ceza, iş, kira ve şirketler hukuku alanlarında bağımsız hukuki danışmanlık. Ankara Barosu sicil no: 46839. Randevu için iletişime geçin."
  currentPage="home"
  canonicalUrl="/"
  heroPreload="/images/banner-home.webp"
>
  <Hero
    title="Hukuki Sorunlarınıza<br>Stratejik Çözümler."
    lead="Ankara'da ceza, iş, kira ve şirketler hukuku alanlarında bağımsız hukuki danışmanlık ve dava takibi."
    size="lg"
    image="/images/banner-home.webp"
    altText="Stratejik Hukuk. Güvenilir Temsil."
  />

  <div class="trust-band">
    <div class="container trust-band-inner">
      <span>Ankara Barosu Sicil No: 46839</span>
      <span class="trust-sep">·</span>
      <span>Görüşmeler randevu ile planlanmaktadır</span>
      <span class="trust-sep">·</span>
      <span>Sitedeki içerikler yalnızca bilgilendirme amaçlıdır</span>
    </div>
  </div>
  <section class="page-section">
    <div class="container">
      <h2 class="section-heading">Çalışma Alanları</h2>

      <div class="grid-layout">
        {workAreas.slice(0, 3).map((area) => (
          <AreaCard
            icon={area.icon}
            title={area.title}
            description={area.description}
            ctaText={area.ctaText}
            ctaLink={area.ctaLink}
          />
        ))}
      </div>

      <div style="text-align: center; margin-top: 40px;">
        <a href="/calisma-alanlari" class="btn">Tüm Alanları İncele</a>
      </div>
    </div>
  </section>

  <section class="page-section">
    <div class="container">
      <h2 class="section-heading">Nasıl Çalışıyoruz?</h2>
      <div class="surec-grid">
        <div class="surec-adim">
          <div class="surec-no" aria-hidden="true">01</div>
          <h3 class="surec-baslik">Olay Analizi</h3>
          <p class="surec-aciklama">Hukuki durumunuzu dinler, belgeleri inceler ve güçlü ile zayıf yönleri net biçimde ortaya koyarız.</p>
        </div>
        <div class="surec-adim">
          <div class="surec-no" aria-hidden="true">02</div>
          <h3 class="surec-baslik">Strateji ve Planlama</h3>
          <p class="surec-aciklama">Size özgü bir hukuki strateji geliştiririz. Olası sonuçları, riskleri ve alternatifleri şeffaf biçimde paylaşırız.</p>
        </div>
        <div class="surec-adim">
          <div class="surec-no" aria-hidden="true">03</div>
          <h3 class="surec-baslik">Şeffaf Süreç Takibi</h3>
          <p class="surec-aciklama">Davanızın her aşamasında bilgilendirilirsiniz. Sürecin neresinde olduğunuzu her zaman bilirsiniz.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="page-section bg-light">
    <div class="container">
      <h2 class="section-heading">Güncel Yayınlar</h2>

      <div class="grid-3">
        {latestArticles.map((article) => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            href={`/yayinlar/${article.id.replace(/\.md$/, "")}`}
            image={article.data.heroImage}
            tag={article.data.tag || ''}
          />
        ))}
      </div>

      <div style="text-align: center; margin-top: 40px;">
        <a href="/yayinlar" class="btn-outline-main">Tüm Yayınları Oku</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-section { padding: 5rem 0; background-color: var(--color-bg); }
  .bg-light { background-color: var(--color-bg-secondary); }

  .grid-layout { display: grid; grid-template-columns: 1fr; gap: 2rem; }
  .grid-3 { display: grid; grid-template-columns: 1fr; gap: 30px; }

  @media (min-width: 768px) {
    .grid-layout { grid-template-columns: repeat(2, 1fr); }
    .grid-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .grid-layout { grid-template-columns: repeat(3, 1fr); }
    .grid-3 { grid-template-columns: repeat(3, 1fr); }
  }
  .trust-band {
    background-color: var(--color-bg-secondary);
    border-bottom: 1px solid var(--color-border);
    padding: 12px 0;
  }
  .trust-band-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 16px;
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.02em;
  }
  .trust-sep { opacity: 0.4; }
  @media (max-width: 640px) {
    .trust-band-inner { flex-direction: column; gap: 4px; text-align: center; }
    .trust-sep { display: none; }
  }
  .surec-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .surec-adim {
    padding: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: var(--card-bg);
    position: relative;
  }
  .surec-no {
    font-size: 3rem;
    font-weight: 800;
    color: transparent;
    line-height: 1;
    margin-bottom: 1rem;
    font-variant-numeric: tabular-nums;
  }
  .surec-baslik {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--brand-primary);
    margin-bottom: 0.75rem;
  }
  html.dark .surec-baslik { color: var(--color-text); }
  .surec-aciklama {
    color: var(--color-text-secondary);
    line-height: 1.7;
    font-size: 0.95rem;
  }
  @media (max-width: 768px) {
    .surec-grid { grid-template-columns: 1fr; gap: 1.25rem; }
  }
</style>
