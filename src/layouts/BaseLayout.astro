---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import SpecialDayBanner from '../components/SpecialDayBanner.astro';
import Footer from '../components/Footer.astro';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title: string;
  description: string;
  image?: string; 
  currentPage?: string;
  canonicalUrl?: string;
  heroPreload?: string;
}

const { 
  title, 
  description, 
  image = "/images/og-image.webp", 
  currentPage,
  canonicalUrl,
  heroPreload
} = Astro.props;

const siteUrl = import.meta.env.SITE || "https://fatihturan.av.tr";
const currentPath = canonicalUrl || Astro.url.pathname;
const finalCanonicalUrl = new URL(currentPath, siteUrl).href;
const finalImageUrl = new URL(image, siteUrl).href;
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Av. Fatih Turan" />
    <link rel="canonical" href={finalCanonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={finalCanonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={finalImageUrl} />
    
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={finalCanonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={finalImageUrl} />


    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <ViewTransitions />

    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
    
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      window.localStorage.setItem('theme', theme);

      // ViewTransitions: sayfa geçişinde dark class'ı koru
      document.addEventListener('astro:after-swap', () => {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      });
    </script>

  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://fatihturan.av.tr/#person",
        "name": "Fatih Turan",
        "givenName": "Fatih",
        "familyName": "Turan",
        "jobTitle": "Avukat",
        "description": "Ankara Barosu'na kayıtlı avukat. Ceza hukuku, iş hukuku, kira hukuku ve şirketler hukuku alanlarında hukuki danışmanlık.",
        "url": "https://fatihturan.av.tr",
        "email": "av.fatihturan@outlook.com",
        "telephone": "+905326100805",
        "alumniOf": { "@type": "CollegeOrUniversity", "name": "Kırıkkale Üniversitesi Hukuk Fakültesi" },
        "memberOf": { "@type": "Organization", "name": "Ankara Barosu", "identifier": "46839" },
        "sameAs": ["https://www.instagram.com/avukatfatihturan", "https://www.linkedin.com/in/fatih-turan-400b9724b/"]
      },
      {
        "@type": "LegalService",
        "@id": "https://fatihturan.av.tr/#legalservice",
        "name": "Av. Fatih Turan Hukuki Danışmanlık",
        "url": "https://fatihturan.av.tr",
        "telephone": "+905326100805",
        "email": "av.fatihturan@outlook.com",
        "provider": { "@id": "https://fatihturan.av.tr/#person" },
        "image": "https://fatihturan.av.tr/images/logo.webp",
        "areaServed": { "@type": "City", "name": "Ankara", "sameAs": "https://www.wikidata.org/wiki/Q3640" },
        "serviceType": ["Ceza Hukuku", "İş Hukuku", "Kira Hukuku", "Şirketler Hukuku", "Uluslararası Hukuk"],
        "priceRange": "Avukatlık Asgari Ücret Tarifesi"
      },
      {
        "@type": "LocalBusiness",
        "@id": "https://fatihturan.av.tr/#localbusiness",
        "name": "Av. Fatih Turan Hukuki Danışmanlık",
        "url": "https://fatihturan.av.tr",
        "telephone": "+905326100805",
        "email": "av.fatihturan@outlook.com",
        "address": { "@type": "PostalAddress", "addressLocality": "Ankara", "addressCountry": "TR" },
        "geo": { "@type": "GeoCoordinates", "latitude": 39.9334, "longitude": 32.8597 },
        "founder": { "@id": "https://fatihturan.av.tr/#person" },
        "openingHours": ["Mo-Fr 09:00-18:00"],
        "image": "https://fatihturan.av.tr/images/logo.webp",
        "priceRange": "Avukatlık Asgari Ücret Tarifesi",
        "sameAs": ["https://www.instagram.com/avukatfatihturan", "https://www.linkedin.com/in/fatih-turan-400b9724b/"]
      }
    ]
  }
  </script>
    {heroPreload && (
      <link rel="preload" as="image" href={heroPreload} fetchpriority="high" />
    )}
    <link rel="preload" href="/fonts/montserrat-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-latin-ext-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-latin-ext-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-latin-ext-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-latin-ext-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body>
    <div class="site-wrapper">
      <SpecialDayBanner />
      <Header currentPage={currentPage} />
      
      <main class="site-main">
        <slot />
      </main>

      <Footer />
    </div>

    <ChatWidget />
  </body>
</html>
